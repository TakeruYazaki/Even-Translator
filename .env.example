# Server only. Never prefix API keys with VITE_.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Private connection code for this app. Generated by npm run setup.
APP_TOKEN=
HOST=127.0.0.1
PORT=8787

# Optional: HTTPS backend origin for a cloud build, e.g. https://your-backend.example
# Leave blank for local development (Vite proxies /ws to port 8787).
VITE_BACKEND_URL=
